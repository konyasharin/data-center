<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain console runner, no test framework package: the point is that the core
       can be checked with nothing but the SDK, on any machine, in a second. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DataCenter.Sim.Tests</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sim\DataCenter.Sim.csproj" />
  </ItemGroup>

</Project>
