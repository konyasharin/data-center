<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately references nothing from Godot. The simulation core has to build
       and run without a scene, which is the boundary docs/10-tech-architecture.md
       draws; the test runner in tests/ exists to keep that honest. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DataCenter.Sim</RootNamespace>
    <AssemblyName>DataCenter.Sim</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

</Project>
